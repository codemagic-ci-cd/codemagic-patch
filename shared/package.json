{
  "name": "@codemagic/patch-shared",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store-artifact": {
      "types": "./dist/storeArtifact/index.d.ts",
      "default": "./dist/storeArtifact/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "store-artifact": [
        "./dist/storeArtifact/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "bplist-parser": "0.5.0",
    "fflate": "^0.8.2",
    "plist": "^3.0.6",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/plist": "^3.0.5",
    "@types/yauzl": "^3",
    "bplist-creator": "0.3.0",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "yarn exec tsc -p tsconfig.build.json",
    "clean": "yarn exec rimraf dist node_modules/.cache",
    "lint": "yarn exec eslint \"src/**/*.ts\"",
    "typecheck": "yarn exec tsc -p tsconfig.json"
  }
}
