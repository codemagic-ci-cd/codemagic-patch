{
  "name": "@codemagic/react-native-patch",
  "version": "0.7.0",
  "description": "React Native client SDK for Codemagic Patch — over-the-air JavaScript & asset updates for React Native and Expo apps.",
  "keywords": [
    "react-native",
    "expo",
    "ota",
    "over-the-air",
    "code-push",
    "hot-update",
    "codemagic",
    "codemagic-patch"
  ],
  "license": "Apache-2.0",
  "homepage": "https://patch.codemagic.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemagic-ci-cd/codemagic-patch.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/codemagic-ci-cd/codemagic-patch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "codegenConfig": {
    "name": "CodemagicPatchSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "io.codemagic.patch"
    },
    "ios": {
      "modulesConformingToProtocol": {
        "RCTTurboModule": [
          "CodemagicPatchModule"
        ]
      }
    }
  },
  "swiftpmConfig": {
    "name": "CodemagicPatchClient"
  },
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "react-native": "./testing.ts",
      "types": "./testing.ts",
      "default": "./dist/testing.js"
    },
    "./jest": {
      "react-native": "./src/fake/jest.ts",
      "types": "./dist/fake/jest.d.ts",
      "default": "./dist/fake/jest.js"
    },
    "./jest-setup": "./jest-setup.js",
    "./vitest": {
      "types": "./dist/fake/vitest.d.ts",
      "default": "./src/fake/vitest.ts"
    },
    "./vitest-setup": "./vitest-setup.ts",
    "./vitest-plugin": {
      "types": "./vitest-plugin.d.ts",
      "default": "./vitest-plugin.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./testing.ts"
      ],
      "jest": [
        "./dist/fake/jest.d.ts"
      ],
      "vitest": [
        "./dist/fake/vitest.d.ts"
      ],
      "vitest-plugin": [
        "./vitest-plugin.d.ts"
      ]
    }
  },
  "files": [
    "android",
    "app.plugin.js",
    "CodemagicPatchClient.podspec",
    "Package.swift",
    "dist",
    "ios",
    "libs",
    "plugin",
    "react-native.config.js",
    "jest-setup.js",
    "vitest-setup.ts",
    "vitest-plugin.js",
    "vitest-plugin.d.ts",
    "testing.ts",
    "src",
    "!**/.cxx",
    "!**/.cxx/**",
    "!**/.gradle",
    "!**/.gradle/**",
    "!**/.kotlin",
    "!**/.kotlin/**",
    "!android/build",
    "!android/build/**",
    "!android/app/build",
    "!android/app/build/**",
    "!ios/build",
    "!ios/build/**",
    "!ios/Pods",
    "!ios/Pods/**",
    "!ios/DerivedData",
    "!ios/DerivedData/**",
    "!**/*.o",
    "!**/*.a",
    "!**/*.so",
    "!**/.DS_Store",
    "!**/*.tsbuildinfo",
    "!**/*.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.36.0",
    "expo": "~56.0.9",
    "jsdom": "^29.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.84.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "yarn exec rimraf dist plugin/build node_modules/.cache && yarn exec tsc -p tsconfig.build.json && yarn exec tsc -p tsconfig.plugin.json",
    "prepare": "rimraf dist plugin/build node_modules/.cache && tsc -p tsconfig.build.json && tsc -p tsconfig.plugin.json",
    "clean": "yarn exec rimraf dist plugin/build node_modules/.cache",
    "lint": "yarn exec eslint \"src/**/*.ts\" \"plugin/**/*.ts\"",
    "typecheck": "yarn exec tsc -p tsconfig.json"
  }
}
