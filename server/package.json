{
  "name": "@codemagic/patch-server",
  "version": "0.11.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1031.0",
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/lib-storage": "^3.1031.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@google-cloud/storage": "^7.19.0",
    "fastify": "^5.4.0",
    "fflate": "^0.8.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "semver": "^7.7.4",
    "zstd-napi": "0.0.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.36.0",
    "rimraf": "^6.0.1",
    "standardwebhooks": "^1.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "yarn exec tsc -p tsconfig.build.json",
    "auth:grant-team-owner": "yarn exec tsx scripts/grantTeamOwner.ts",
    "clean": "yarn exec rimraf dist node_modules/.cache",
    "dev": "yarn exec tsx src/main.ts",
    "lint": "yarn exec eslint \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "typecheck": "yarn exec tsc -p tsconfig.json"
  }
