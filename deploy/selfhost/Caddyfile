# Site addresses take their scheme from CODEMAGIC_PATCH_SITE_SCHEME. The base
# compose file leaves it unset, so the addresses stay bare and Caddy serves
# them over automatic HTTPS with Let's Encrypt. The plain-HTTP overlay
# (deploy/selfhost/compose.http.yml, selected by SELFHOST_SCHEME=http) sets it
# to "http://", which makes every site here plain HTTP on port 80 with no
# certificate and no HTTP->HTTPS redirect. One file serves both, so the two
# schemes cannot drift apart in anything but the scheme.
{
	email {$ACME_EMAIL}
}

{$CODEMAGIC_PATCH_SITE_SCHEME}{$CODEMAGIC_PATCH_API_DOMAIN} {
	encode zstd gzip

	# Drop the Server header Caddy puts on every response this site writes,
	# its own /worker/* 404 included. The automatic port 80 -> HTTPS redirect
	# is served outside this site and still says "Server: Caddy".
	header -Server

	# /worker/* is intentionally NOT exposed publicly. In MODE=all (the only
	# self-host topology) release reconciliation runs in-process; the HTTP
	# /worker/reconcile route is only used by the distributed worker topology.
	# Exposing it here would put the worker endpoint on the public internet for
	# no functional gain. The catch-all proxy below would forward it, so it is
	# answered here instead. Do not remove this block.
	handle /worker/* {
		respond 404
	}

	# The server answers everything else: /v1/*, /health*, and the dashboard
	# SPA, which it serves from its own image (unknown paths outside the API
	# fall back to index.html, so deep links and /auth/callback work). It sets
	# the dashboard's Content-Security-Policy and Strict-Transport-Security on
	# every response, so Caddy adds neither.
	handle {
		reverse_proxy server:3000
		# The server sends HSTS unconditionally. Browsers ignore it over plain
		# HTTP and RFC 6797 forbids sending it there, so drop it when this site
		# is served without TLS (SELFHOST_SCHEME=http). Over HTTPS nothing
		# matches: port 80 only redirects and never reaches this site.
		@plain_http protocol http
		header @plain_http -Strict-Transport-Security
	}
}

{$CODEMAGIC_PATCH_SITE_SCHEME}{$CODEMAGIC_PATCH_STORAGE_DOMAIN} {
	encode zstd gzip

	reverse_proxy minio:9000
}
