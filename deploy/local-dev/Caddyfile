# Local evaluation dashboard — plain HTTP on :8080, no ACME/TLS. Runs the same
# stock Caddy image as the self-host stack and, like it, proxies everything to
# the server, which serves the dashboard SPA from its own image. The
# evaluation stack therefore serves the same shippable dashboard artifact as
# production, and the two cannot drift silently.

{
	auto_https off
}

:8080 {
	encode zstd gzip

	# Caddy names itself in a Server header on every response, its own
	# /worker/* 404 included; drop it site-wide.
	header -Server

	# /worker/* is intentionally not proxied — same reasoning as the
	# self-host Caddyfile: MODE=all reconciles in-process.
	handle /worker/* {
		respond 404
	}

	# Same-origin API and dashboard: the SPA's empty VITE_API_BASE_URL default
	# resolves to window.location.origin, so /v1/* needs no CORS work. The
	# server sets the dashboard's CSP itself.
	handle {
		reverse_proxy server:3000
		# The server sends HSTS unconditionally; this site is plain HTTP
		# only, where RFC 6797 forbids it.
		header -Strict-Transport-Security
	}
}
